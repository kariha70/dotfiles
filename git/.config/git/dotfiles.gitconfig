# Personal Git settings shared by every profile, stowed to
# ~/.config/git/dotfiles.gitconfig.
#
# Default profile: included first by the stowed ~/.gitconfig (git/.gitconfig),
# which adds that profile's editor, ignore file, colors, and aliases.
#
# Omarchy profile: reached through the symlink
# omarchy/.config/git/dotfiles.gitconfig and included at the end of Omarchy's
# ~/.config/git/config (install/omarchy-config.sh), so Omarchy's defaults
# (pull.rebase, push.autoSetupRemote, rerere, histogram diffs, aliases, $EDITOR)
# stay in place and only these settings are added or overridden.
#
# Keep it to what both profiles want; anything else goes in git/.gitconfig.

[user]
	name = Kari Hagemeier
	email = kari@hagemeier.cloud
	signingkey = ssh-rsa 

[init]
	defaultBranch = main

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	side-by-side = true
	line-numbers = true

[merge]
	conflictstyle = diff3

# Machine-specific settings (SSH signing, credential helpers) from install/git-config.sh.
[include]
	path = ~/.gitconfig.local
