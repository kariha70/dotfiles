# Default profile's ~/.gitconfig.
#
# Identity, signing key, delta, and the machine-specific ~/.gitconfig.local
# come from the settings shared with the Omarchy profile
# (git/.config/git/dotfiles.gitconfig); only what this profile adds on top
# lives here.
[include]
    path = ~/.config/git/dotfiles.gitconfig

# Refuse to commit with a guessed identity when the include above is missing,
# e.g. after pulling this change without restowing (ONLY_STOW=1 ./bootstrap.sh).
[user]
    useConfigOnly = true

[core]
    editor = vim
    excludesfile = ~/.gitignore_global

[delta]
    light = false

[diff]
    colorMoved = default

[color]
    ui = auto

[alias]
    st = status
    co = checkout
    br = branch
    ci = commit
