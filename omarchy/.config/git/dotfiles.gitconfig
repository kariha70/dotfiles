# Git overlay for the Omarchy profile.
#
# Included at the end of Omarchy's ~/.config/git/config (install/omarchy-config.sh),
# so Omarchy's defaults (pull.rebase, push.autoSetupRemote, rerere, histogram
# diffs, aliases) stay in place and only these personal settings are added or
# overridden. The editor comes from Omarchy's $EDITOR, and global ignores from
# ~/.config/git/ignore (git's default location).

[user]
	name = Kari Hagemeier
	email = kari@hagemeier.cloud
	signingkey = ssh-rsa 

[init]
	defaultBranch = main

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	side-by-side = true
	line-numbers = true

[merge]
	conflictstyle = diff3

# Machine-specific settings (SSH signing, credential helpers) from install/git-config.sh.
[include]
	path = ~/.gitconfig.local
